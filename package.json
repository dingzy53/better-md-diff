{
  "name": "uncommitted",
  "version": "0.5.2",
  "private": true,
  "description": "List every file that differs from the last Git commit, with status letters and a simple diff.",
  "license": "MIT",
  "author": "Ding Zheng Yuan",
  "homepage": "https://github.com/dingzy53/obsidian-uncommited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingzy53/obsidian-uncommited.git"
  },
  "bugs": {
    "url": "https://github.com/dingzy53/obsidian-uncommited/issues"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "install:vault": "node scripts/install-to-vault.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "check:english": "node scripts/check-english.mjs",
    "check": "npm run check:english && npm run lint && npm run test && npm run build && npm run check:release",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.0.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
